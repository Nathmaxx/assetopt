{
  "name": "assetopt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static asset optimization tool — open-source CLI with optional paid Pro extensions",
  "license": "MIT",
  "author": "Nath",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assetopt": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathmaxx/assetopt.git"
  },
  "bugs": {
    "url": "https://github.com/Nathmaxx/assetopt/issues"
  },
  "homepage": "https://github.com/Nathmaxx/assetopt#readme"
}
